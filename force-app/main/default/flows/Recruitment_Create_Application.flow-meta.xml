<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Verifies candidate exists, job requisition exists and is open, prevents duplicate applications, and creates a Job Application record</description>
    <label>Recruitment Create Job Application</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <decisions>
        <name>Check_Candidate_Found</name>
        <label>Check Candidate Found</label>
        <locationX>380</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Set_Candidate_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Candidate Not Found</defaultConnectorLabel>
        <rules>
            <name>Candidate_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>candidateRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Open_Job_Requisition</targetReference>
            </connector>
            <label>Candidate Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Job_Found</name>
        <label>Check Job Found</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Set_Job_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Job Not Found Or Closed</defaultConnectorLabel>
        <rules>
            <name>Job_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>jobRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Application</targetReference>
            </connector>
            <label>Job Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Duplicate_Application</name>
        <label>Check Duplicate Application</label>
        <locationX>50</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Set_Duplicate_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Duplicate Exists</defaultConnectorLabel>
        <rules>
            <name>No_Duplicate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>existingApplication</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Application_Record</targetReference>
            </connector>
            <label>No Duplicate</label>
        </rules>
    </decisions>
    <recordLookups>
        <name>Get_Candidate</name>
        <label>Get Candidate</label>
        <locationX>380</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Candidate_Found</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Candidate_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>candidateName</elementReference>
            </value>
        </filters>
        <filters>
            <field>Email__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>candidateName</elementReference>
            </value>
        </filters>
        <object>Candidate__c</object>
        <outputReference>candidateRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Candidate_Name__c</queriedFields>
        <queriedFields>Email__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Open_Job_Requisition</name>
        <label>Get Open Job Requisition</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Job_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </filters>
        <filters>
            <field>Job_Title__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>jobTitleOrCode</elementReference>
            </value>
        </filters>
        <object>Job_Requisition__c</object>
        <outputReference>jobRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Job_Title__c</queriedFields>
        <queriedFields>Job_Code__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Existing_Application</name>
        <label>Get Existing Application</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Duplicate_Application</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Candidate__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>candidateRecord.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Job_Requisition__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>jobRecord.Id</elementReference>
            </value>
        </filters>
        <object>Job_Application__c</object>
        <outputReference>existingApplication</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Application_Number__c</queriedFields>
        <queriedFields>Application_Status__c</queriedFields>
    </recordLookups>
    <recordCreates>
        <name>Create_Application_Record</name>
        <label>Create Application Record</label>
        <locationX>50</locationX>
        <locationY>782</locationY>
        <assignRecordIdToReference>applicationId</assignRecordIdToReference>
        <connector>
            <targetReference>Set_Success_Output</targetReference>
        </connector>
        <inputAssignments>
            <field>Candidate__c</field>
            <value>
                <elementReference>candidateRecord.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Job_Requisition__c</field>
            <value>
                <elementReference>jobRecord.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Application_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Application_Status__c</field>
            <value>
                <stringValue>Applied</stringValue>
            </value>
        </inputAssignments>
        <object>Job_Application__c</object>
    </recordCreates>
    <assignments>
        <name>Set_Success_Output</name>
        <label>Set Success Output</label>
        <locationX>50</locationX>
        <locationY>890</locationY>
        <assignmentItems>
            <assignToReference>isSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>resultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Application successfully created for candidate in Applied status.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Candidate_Not_Found</name>
        <label>Set Candidate Not Found</label>
        <locationX>578</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>isSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>resultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Candidate was not found in Salesforce. Please verify the candidate name.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Job_Not_Found</name>
        <label>Set Job Not Found</label>
        <locationX>314</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>isSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>resultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Job requisition was not found or is currently not Open. Applications can only be submitted for open positions.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Duplicate_Error</name>
        <label>Set Duplicate Error</label>
        <locationX>200</locationX>
        <locationY>782</locationY>
        <assignmentItems>
            <assignToReference>isSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>resultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>An application already exists for this candidate for this job requisition. Duplicate applications cannot be created.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Candidate</targetReference>
        </connector>
    </start>
    <variables>
        <name>candidateName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>jobTitleOrCode</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>candidateRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Candidate__c</objectType>
    </variables>
    <variables>
        <name>jobRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Job_Requisition__c</objectType>
    </variables>
    <variables>
        <name>existingApplication</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Job_Application__c</objectType>
    </variables>
    <variables>
        <name>applicationId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>isSuccess</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>resultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
